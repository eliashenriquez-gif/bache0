# ─────────────────────────────────────────────────────────────────────────────
# Bache 0 · Configuración de ejemplo
# Copia este archivo como backend/.env y completa los valores.
# (backend/.env.example es una copia idéntica de este archivo.)
# NUNCA subas el archivo .env real al repositorio: está excluido en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor y seguridad ──
PORT=3000
# Obligatorio: mínimo 32 caracteres. Mientras conserve este valor de ejemplo, el servidor NO arranca.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZAR_secreto_jwt
# Orígenes permitidos del navegador, separados por coma. Sin definir: cualquiera (solo desarrollo).
# CORS_ORIGINS=https://tu-app.vercel.app,http://localhost:5173

# ── Base de datos PostgreSQL ──
PGHOST=localhost
PGPORT=5432
PGDATABASE=bache0_dev
PGUSER=REEMPLAZAR_usuario_postgres
PGPASSWORD=REEMPLAZAR_password_postgres

# ── Superadministrador inicial (SOLO desarrollo) ──
# Se crea al iniciar si no existe. Contraseña de 12 a 128 caracteres (con el valor de ejemplo el servidor se detiene con un mensaje claro).
SEED_SUPERADMIN_EMAIL=superadmin@example.test
SEED_SUPERADMIN_PASSWORD=REEMPLAZAR
SEED_SUPERADMIN_NOMBRE=Superadministrador

# ── Visión artificial local (TensorFlow.js + sharp) ──
# VISION_ENABLED=false   # descomentar para apagar el análisis de imágenes
VISION_TIMEOUT_MS=30000
VISION_MAX_COLA=20
VISION_REQUEST_RATE_LIMIT_PER_MINUTE=10
# Opción experimental RF-DETR (apagada por defecto; requiere Python y clave en el entorno):
# VISION_V2_PROVIDER=rfdetr
# ROBOFLOW_API_KEY=

# ── Ubicación (Nominatim / OpenStreetMap) ──
# El servidor consulta Nominatim con un User-Agent fijo en el código y una caché de 60 s.
# Límite de consultas del endpoint de ubicación por IP y por minuto (por defecto 20):
# LOCATION_RATE_LIMIT_PER_MINUTE=20

# ── Red y límites ──
# Detrás de un túnel o proxy en el mismo equipo (p. ej. Cloudflare Tunnel):
# TRUST_PROXY=loopback
# JSON_BODY_LIMIT=100kb
# Reportes ciudadanos permitidos por IP cada 10 minutos (por defecto 5):
# REPORT_RATE_LIMIT_PER_10_MINUTES=5

# ═════════════════════════════════════════════════════════════════════════════
# SOLO PARA EVALUACIÓN: cuentas ficticias que crea backend/scripts/preparar-usuarios-evaluacion.mjs
# (administradores de Estación Central, La Pintana y El Bosque, e inspector de Estación Central).
# Defínelas solo en tu .env local, con contraseñas propias de 12 a 128 caracteres. Nunca las subas.
# Cuentas @example.test o similares; este archivo no trae valores reales.
# ═════════════════════════════════════════════════════════════════════════════
# BACHE0_API_URL=http://localhost:3000/api/v1
# BACHE0_DEMO_EC_EMAIL=admin.ec@example.test
# BACHE0_DEMO_EC_PASSWORD=REEMPLAZAR
# BACHE0_DEMO_LP_EMAIL=admin.lp@example.test
# BACHE0_DEMO_LP_PASSWORD=REEMPLAZAR
# BACHE0_DEMO_EB_EMAIL=admin.eb@example.test
# BACHE0_DEMO_EB_PASSWORD=REEMPLAZAR
# BACHE0_DEMO_INS_EC_EMAIL=inspector.ec@example.test
# BACHE0_DEMO_INS_EC_PASSWORD=REEMPLAZAR

# ═════════════════════════════════════════════════════════════════════════════
# INTERFAZ (Vite) · NO contiene secretos
# Solo si el backend no corre en http://localhost:3000 (sin /api/v1). Se define al ejecutar
# `npm run dev` en la raíz, no en backend/.env.
# ═════════════════════════════════════════════════════════════════════════════
# VITE_API_URL=http://localhost:3000
