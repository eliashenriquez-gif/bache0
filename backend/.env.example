# Copia este archivo como .env y completa los valores.

# ── Servidor y Seguridad ──
PORT=3000
# Generar un secreto: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tu_secreto_aqui_para_jwt
# Orígenes permitidos (Ej: http://localhost:5173 para el frontend)
CORS_ORIGIN=*

# ── Base de Datos PostgreSQL ──
PGHOST=localhost
PGPORT=5432
PGDATABASE=bache0_dev
PGUSER=tu_usuario_postgres
PGPASSWORD=tu_password_postgres

# ── Superadministrador Inicial (Solo Desarrollo) ──
SEED_SUPERADMIN_EMAIL=admin@bache0.cl
SEED_SUPERADMIN_PASSWORD=password_seguro_123
SEED_SUPERADMIN_NOMBRE=Superadministrador

# ── Visión artificial local (TensorFlow.js + sharp) ──
# VISION_ENABLED=false (Descomentar para apagar el análisis de IA)
VISION_TIMEOUT_MS=30000
VISION_MAX_COLA=20
VISION_REQUEST_RATE_LIMIT_PER_MINUTE=10

# ── Ubicación (Nominatim) ──
NOMINATIM_USER_AGENT=Bache0-GovTech-App/1.0 (contacto@tu-dominio.cl)
NOMINATIM_MIN_INTERVAL_MS=1000
# CLASIFICACION_VIAL_ENABLED=false (Se deja apagado por decisión de alcance)
# ── Red, CORS y límites (Hito 3) ──
# Detrás de un túnel/proxy en el mismo equipo (p. ej. Cloudflare Tunnel): sin esto, todos los ciudadanos
# comparten la IP del túnel y el límite de reportes por IP los bloquea a todos a la vez.
# TRUST_PROXY=loopback
# Orígenes permitidos del navegador, separados por coma (tu app en Vercel y el servidor local de Vite).
# Sin definir, la API acepta cualquier origen (solo desarrollo).
# CORS_ORIGINS=https://tu-app.vercel.app,http://localhost:5173
# Tamaño máximo de cuerpos JSON (la foto viaja como multipart y tiene su propio límite de 10 MB). Por defecto 100kb.
# JSON_BODY_LIMIT=100kb
# Reportes ciudadanos permitidos por IP cada 10 minutos. Por defecto 5.
# REPORT_RATE_LIMIT_PER_10_MINUTES=5
