# Copia este archivo como .env (que debe estar en .gitignore) y completa los valores.

# Generar un secreto: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Primer superadministrador (solo desarrollo). La contraseña debe tener entre 12 y 128 caracteres.
# No escribas valores reales en este archivo de ejemplo.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NOMBRE=Superadministrador
