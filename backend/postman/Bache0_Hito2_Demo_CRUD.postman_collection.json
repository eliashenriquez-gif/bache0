              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superadmin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Mismo folio\", () => pm.expect(pm.response.json().data.folio).to.eql(pm.collectionVariables.get(\"reporte_folio\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 · Cambiar estado a en_revision (200)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reportes/{{reporte_id}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "{{reporte_id}}",
                "estado"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superadmin_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"en_revision\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estado actualizado\", () => pm.expect(pm.response.json().data.estado).to.eql(\"en_revision\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 · Editar el reporte (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reportes/{{reporte_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "{{reporte_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superadmin_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severidad\": \"alta\",\n  \"concurrencia_vial\": \"alta\",\n  \"infraestructura_critica\": \"ninguna\",\n  \"descripcion\": \"PRUEBA POSTMAN BACHE0 - FICTICIO - EDITADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Severidad actualizada\", () => pm.expect(pm.response.json().data.severidad).to.eql(\"alta\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 · Archivar el reporte (204)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reportes/{{reporte_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "{{reporte_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superadmin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 · Confirmar: el reporte archivado ya no aparece (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reportes/{{reporte_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "{{reporte_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superadmin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Formato de error uniforme\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    }
